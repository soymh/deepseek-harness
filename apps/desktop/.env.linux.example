# Copy to .env.linux (Git ignored). Use UTF-8 and quote values containing # or spaces.
# Values are not shell-expanded.
DSH_DESKTOP_APP_ID=com.deepseek.dsh
DSH_DESKTOP_AUTO_UPDATE_ENV=test

# Optional caller-owned HTTPS feed: an absolute directory URL that already hosts the channel metadata
# (`nightly-linux.yml`) and the artifacts. Set, it replaces the DOWNLOAD_* deployment layout below,
# and the COS upload commands refuse it because that hosting publishes its own files.
# DSH_DESKTOP_FEED_URL=https://github.com/OWNER/REPO/releases/latest/download/

DOWNLOAD_TEST_ORIGIN=
# Required for test releases: 32 lowercase hexadecimal characters from a secure random generator.
# Generate once per release batch; retain it for retries and versions testing upgrades within that batch.
DOWNLOAD_TEST_RELEASE_ID=

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com

# Workers for first-party and vendor workspace tarballs; requires a positive integer.
DSH_DESKTOP_LINUX_PACK_CONCURRENCY=4

# AppImage squashfs compression: store, normal (zlib), or maximum (xz).
# Lower values trade a larger download for faster builds and mounts.
DSH_DESKTOP_LINUX_COMPRESSION=maximum

# Optional upload configuration; packaging does not require these credentials.
# DOWNLOAD_TEST_COS_BUCKET=
# DOWNLOAD_TEST_COS_SECRET_ID=
# DOWNLOAD_TEST_COS_SECRET_KEY=
# DOWNLOAD_PROD_COS_BUCKET=
# DOWNLOAD_PROD_COS_SECRET_ID=
# DOWNLOAD_PROD_COS_SECRET_KEY=

# Required for upload:latest:* and purge:latest on the production deployment.
# DOWNLOAD_PROD_EO_ZONE_ID=
